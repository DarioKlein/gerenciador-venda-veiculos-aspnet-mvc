@model IEnumerable<GerenciadorVendaVeiculos.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";

    (string classes, string label) AreaBadge(GerenciadorVendaVeiculos.Models.TipoArea area) => area switch
    {
        GerenciadorVendaVeiculos.Models.TipoArea.PessoaFisica => ("bg-blue-50 text-blue-700 border-blue-200", "Pessoa Física"),
        GerenciadorVendaVeiculos.Models.TipoArea.PessoaJuridica => ("bg-purple-50 text-purple-700 border-purple-200", "Pessoa Jurídica"),
        _ => ("bg-ink/5 text-steel border-line", area.ToString())
    };
}

<div class="flex flex-col gap-5 justify-between mb-6 sm:flex-row sm:items-center sm:gap-0">
    <div>
        <h2 class="font-display text-2xl font-semibold text-ink">Clientes</h2>
        <p class="text-sm text-steel mt-1">Clientes cadastrados no sistema.</p>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-signal text-white font-medium hover:bg-signal/90 transition-colors">
        <i data-lucide="plus" class="w-4 h-4"></i>
        Novo cliente
    </a>
</div>

@if (!Model.Any())
{
    <div class="border border-line rounded-md py-12 text-center">
        <p class="text-steel">Nenhum cliente cadastrado ainda.</p>
    </div>
}
else
{
    <div class="border border-line rounded-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm min-w-[720px]">
                <thead>
                    <tr class="border-b border-line bg-ink/[0.02] text-left">
                        <th class="px-4 py-3 font-medium text-steel">Nome</th>
                        <th class="px-4 py-3 font-medium text-steel">Área</th>
                        <th class="px-4 py-3 font-medium text-steel">Idade</th>
                        <th class="px-4 py-3 font-medium text-steel">Valor Hora</th>
                        <th class="px-4 py-3 font-medium text-steel">Cidade</th>
                        <th class="px-4 py-3 font-medium text-steel w-0"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var (badgeClasses, badgeLabel) = AreaBadge(item.Area);
                        <tr class="border-b border-line last:border-0 hover:bg-ink/[0.02]">
                            <td class="px-4 py-3 text-ink font-medium">@Html.DisplayFor(modelItem => item.Nome)</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium border @badgeClasses">
                                    @badgeLabel
                                </span>
                            </td>
                            <td class="px-4 py-3 text-steel">@Html.DisplayFor(modelItem => item.Idade)</td>
                            <td class="px-4 py-3 text-ink">@item.ValorHora.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</td>
                            <td class="px-4 py-3 text-steel">@Html.DisplayFor(modelItem => item.Cidade.Descricao)</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-end gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="p-2 rounded-md text-steel hover:text-ink hover:bg-ink/5" title="Detalhes">
                                        <i data-lucide="eye" class="w-4 h-4"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="p-2 rounded-md text-steel hover:text-ink hover:bg-ink/5" title="Editar">
                                        <i data-lucide="pencil" class="w-4 h-4"></i>
                                    </a>
                                    <button type="button" class="p-2 rounded-md text-steel hover:text-red-600 hover:bg-red-50"
                                            title="Excluir"
                                            data-delete-id="@item.Id"
                                            data-delete-nome="@item.Nome">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div id="delete-modal-overlay" class="absolute inset-0 bg-ink/60"></div>
    <div class="relative bg-white rounded-md shadow-xl w-full max-w-sm p-6">
        <h3 class="font-display font-semibold text-lg text-ink">Excluir cliente</h3>
        <p class="mt-2 text-sm text-steel">
            Tem certeza que deseja excluir <strong id="delete-modal-nome" class="text-ink"></strong>?
            Essa ação não pode ser desfeita.
        </p>
        <form id="delete-form" method="post" class="mt-6 flex justify-end gap-2">
            @Html.AntiForgeryToken()
            <button type="button" id="delete-modal-cancel"
                    class="px-4 py-2 rounded-md border border-line text-ink font-medium hover:bg-ink/5 transition-colors">
                Cancelar
            </button>
            <button type="submit"
                    class="px-4 py-2 rounded-md bg-red-600 text-white font-medium hover:bg-red-700 transition-colors">
                Excluir
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modal = document.getElementById('delete-modal');
            const overlay = document.getElementById('delete-modal-overlay');
            const cancelBtn = document.getElementById('delete-modal-cancel');
            const nomeEl = document.getElementById('delete-modal-nome');
            const form = document.getElementById('delete-form');
            const baseUrl = '@Url.Action("Delete")';

            document.querySelectorAll('[data-delete-id]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    nomeEl.textContent = btn.getAttribute('data-delete-nome');
                    form.action = baseUrl + '/' + btn.getAttribute('data-delete-id');
                    modal.classList.remove('hidden');
                });
            });

            function closeModal() {
                modal.classList.add('hidden');
            }

            cancelBtn.addEventListener('click', closeModal);
            overlay.addEventListener('click', closeModal);
        })();
    </script>
}