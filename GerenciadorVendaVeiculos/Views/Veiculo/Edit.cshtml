@model GerenciadorVendaVeiculos.Models.ViewModels.VeiculoViewModel

@{
    ViewData["Title"] = "Editar veículo";
}

<div class="max-w-md">
    <h2 class="font-display text-2xl font-semibold text-ink flex items-center gap-2">
        <i data-lucide="car" class="w-6 h-6 text-signal"></i>
        <span>Editar veículo</span>
    </h2>
    <p class="text-sm text-steel mt-1 mb-6">Atualize os dados do veículo.</p>

    <form asp-action="Edit" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="Modelo" class="block text-sm font-medium text-ink mb-1"></label>
            <input asp-for="Modelo" placeholder="Ex.: Corolla" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
            <span asp-validation-for="Modelo" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="MarcaId" class="block text-sm font-medium text-ink mb-1"></label>
            <select asp-for="MarcaId" asp-items="ViewBag.MarcaId"
                    class="w-full rounded-md border border-line px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal">
            </select>
            <span asp-validation-for="MarcaId" class="text-red-600 text-xs"></span>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="Ano" class="block text-sm font-medium text-ink mb-1"></label>
                <input asp-for="Ano" placeholder="Ex.: 2024" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
                <span asp-validation-for="Ano" class="text-red-600 text-xs"></span>
            </div>
            <div>
                <label asp-for="Cor" class="block text-sm font-medium text-ink mb-1"></label>
                <input asp-for="Cor" placeholder="Ex.: Prata" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
                <span asp-validation-for="Cor" class="text-red-600 text-xs"></span>
            </div>
        </div>

        <div>
            <label asp-for="Valor" class="block text-sm font-medium text-ink mb-1"></label>
            <input asp-for="Valor" type="number" step="0.01" placeholder="Ex.: 85000,00" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
            <span asp-validation-for="Valor" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="Situacao" class="block text-sm font-medium text-ink mb-1"></label>
            <select asp-for="Situacao"
                    asp-items="Html.GetEnumSelectList<GerenciadorVendaVeiculos.Models.SituacaoVeiculo>()"
                    class="w-full rounded-md border border-line px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal">
            </select>
            <span asp-validation-for="Situacao" class="text-red-600 text-xs"></span>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-4 py-2 rounded-md bg-signal text-white font-medium hover:bg-signal/90 transition-colors">
                Salvar
            </button>
            <a asp-action="Index" class="px-4 py-2 rounded-md border border-line text-ink font-medium hover:bg-ink/5 transition-colors">
                Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
