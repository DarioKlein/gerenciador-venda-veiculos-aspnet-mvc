@model GerenciadorVendaVeiculos.Models.ViewModels.ClienteViewModel

@{
    ViewData["Title"] = "Novo cliente";
}

<div class="max-w-md">
    <h2 class="font-display text-2xl font-semibold text-ink flex items-center gap-2">
        <i data-lucide="users" class="w-6 h-6 text-signal"></i>
        <span>Novo cliente</span>
    </h2>
    <p class="text-sm text-steel mt-1 mb-6">Cadastre um novo cliente.</p>

    <form asp-action="Create" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

        <div>
            <label asp-for="Nome" class="block text-sm font-medium text-ink mb-1"></label>
            <input asp-for="Nome" placeholder="Ex.: João da Silva" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
            <span asp-validation-for="Nome" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="Area" class="block text-sm font-medium text-ink mb-1"></label>
            <select asp-for="Area"
                    asp-items="Html.GetEnumSelectList<GerenciadorVendaVeiculos.Models.TipoArea>()"
                    class="w-full rounded-md border border-line px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal">
            </select>
            <span asp-validation-for="Area" class="text-red-600 text-xs"></span>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="Idade" class="block text-sm font-medium text-ink mb-1"></label>
                <input asp-for="Idade" placeholder="Ex.: 30" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
                <span asp-validation-for="Idade" class="text-red-600 text-xs"></span>
            </div>
            <div>
                <label asp-for="ValorHora" class="block text-sm font-medium text-ink mb-1"></label>
                <input asp-for="ValorHora" type="number" step="0.01" placeholder="Ex.: 75,00" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
                <span asp-validation-for="ValorHora" class="text-red-600 text-xs"></span>
            </div>
        </div>

        <div>
            <label asp-for="CidadeId" class="block text-sm font-medium text-ink mb-1"></label>
            <select asp-for="CidadeId" asp-items="ViewBag.CidadeId"
                    class="w-full rounded-md border border-line px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal">
                <option value="">Selecione...</option>
            </select>
            <span asp-validation-for="CidadeId" class="text-red-600 text-xs"></span>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-4 py-2 rounded-md bg-signal text-white font-medium hover:bg-signal/90 transition-colors">
                Salvar
            </button>
            <a asp-action="Index" class="px-4 py-2 rounded-md border border-line text-ink font-medium hover:bg-ink/5 transition-colors">
                Cancelar
            </a>
        </div>
    </form>
</div>
