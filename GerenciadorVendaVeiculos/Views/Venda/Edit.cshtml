@model GerenciadorVendaVeiculos.Models.ViewModels.VendaViewModel

@{
    ViewData["Title"] = "Editar venda";
}

<div class="max-w-md">
    <h2 class="font-display text-2xl font-semibold text-ink">Editar venda</h2>
    <p class="text-sm text-steel mt-1 mb-6">Atualize os dados da venda.</p>

    <form asp-action="Edit" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="ClienteId" class="block text-sm font-medium text-ink mb-1"></label>
            <select asp-for="ClienteId" asp-items="ViewBag.ClienteId"
                    class="w-full rounded-md border border-line px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal">
            </select>
            <span asp-validation-for="ClienteId" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="VeiculoId" class="block text-sm font-medium text-ink mb-1"></label>
            <select asp-for="VeiculoId" asp-items="ViewBag.VeiculoId"
                    class="w-full rounded-md border border-line px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal">
            </select>
            <span asp-validation-for="VeiculoId" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="DataVenda" class="block text-sm font-medium text-ink mb-1"></label>
            <input asp-for="DataVenda" placeholder="Selecione a data da venda" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
            <span asp-validation-for="DataVenda" class="text-red-600 text-xs"></span>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="ValorVenda" class="block text-sm font-medium text-ink mb-1"></label>
                <input asp-for="ValorVenda" type="number" step="0.01" placeholder="Ex.: 85000,00" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
                <span asp-validation-for="ValorVenda" class="text-red-600 text-xs"></span>
            </div>
            <div>
                <label asp-for="ValorCausa" class="block text-sm font-medium text-ink mb-1"></label>
                <input asp-for="ValorCausa" type="number" step="0.01" placeholder="Ex.: 5000,00" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
                <span asp-validation-for="ValorCausa" class="text-red-600 text-xs"></span>
            </div>
        </div>

        <div>
            <label asp-for="Vendedor" class="block text-sm font-medium text-ink mb-1"></label>
            <input asp-for="Vendedor" placeholder="Ex.: Maria Oliveira" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
            <span asp-validation-for="Vendedor" class="text-red-600 text-xs"></span>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-4 py-2 rounded-md bg-signal text-white font-medium hover:bg-signal/90 transition-colors">
                Salvar
            </button>
            <a asp-action="Index" class="px-4 py-2 rounded-md border border-line text-ink font-medium hover:bg-ink/5 transition-colors">
                Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
