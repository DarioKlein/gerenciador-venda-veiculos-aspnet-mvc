@model GerenciadorVendaVeiculos.Models.ViewModels.MarcaViewModel

@{
    ViewData["Title"] = "Editar marca";
}

<div class="max-w-md">
    <h2 class="font-display text-2xl font-semibold text-ink">Editar marca</h2>
    <p class="text-sm text-steel mt-1 mb-6">Atualize os dados do fabricante.</p>

    <form asp-action="Edit" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="Nome" class="block text-sm font-medium text-ink mb-1"></label>
            <input asp-for="Nome" placeholder="Ex.: Toyota" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
            <span asp-validation-for="Nome" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="Sigla" class="block text-sm font-medium text-ink mb-1"></label>
            <input asp-for="Sigla" placeholder="Ex.: TOY" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-signal/50 focus:border-signal" />
            <span asp-validation-for="Sigla" class="text-red-600 text-xs"></span>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-4 py-2 rounded-md bg-signal text-white font-medium hover:bg-signal/90 transition-colors">
                Salvar
            </button>
            <a asp-action="Index" class="px-4 py-2 rounded-md border border-line text-ink font-medium hover:bg-ink/5 transition-colors">
                Cancelar
            </a>
        </div>
    </form>
</div>
