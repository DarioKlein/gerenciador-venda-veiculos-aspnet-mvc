@model GerenciadorVendaVeiculos.Models.Cidade

@{
    ViewData["Title"] = "Detalhes da cidade";
}

<div class="max-w-md">
    <h2 class="font-display text-2xl font-semibold text-ink">@Model.Descricao</h2>
    <p class="text-sm text-steel mt-1 mb-6">Detalhes da cidade cadastrada.</p>

    <dl class="border border-line rounded-md divide-y divide-line">
        <div class="flex justify-between px-4 py-3">
            <dt class="text-sm text-steel">@Html.DisplayNameFor(model => model.Descricao)</dt>
            <dd class="text-sm text-ink font-medium">@Html.DisplayFor(model => model.Descricao)</dd>
        </div>
        <div class="flex justify-between px-4 py-3">
            <dt class="text-sm text-steel">@Html.DisplayNameFor(model => model.Sigla)</dt>
            <dd class="text-sm text-ink font-medium">@Html.DisplayFor(model => model.Sigla)</dd>
        </div>
    </dl>

    <div class="mt-6 flex gap-3">
        <a asp-action="Edit" asp-route-id="@Model?.Id"
           class="px-4 py-2 rounded-md bg-signal text-white font-medium hover:bg-signal/90 transition-colors">
            Editar
        </a>
        <a asp-action="Index" class="px-4 py-2 rounded-md border border-line text-ink font-medium hover:bg-ink/5 transition-colors">
            Voltar
        </a>
    </div>
</div>